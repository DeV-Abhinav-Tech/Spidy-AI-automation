rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write to their own user records and task collections
    match /users/{userId} {
      allow read, write: if request.auth != null;

      match /tasks/{taskId} {
        allow read, write: if request.auth != null;
      }

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
